---
import ProjectSection from "@/components/ProjectSection"
import Timeline from "@/components/Timeline"
import Education from "@/components/Education"
import Skills from "@/components/Skills"
import Avatar from "@/components/Avatar"
import Layout from "@/layouts/Layout.astro"
import { HiOutlineArrowDownCircle as DownIcon } from "react-icons/hi2"
import "@/styles/globals.css"
---

<script is:inline>
  const getThemePreference = () => {
    if (typeof localStorage !== "undefined" && localStorage.getItem("theme")) {
      return localStorage.getItem("theme")
    }
    return window.matchMedia("(prefers-color-scheme: dark)").matches
      ? "dark"
      : "light"
  }
  const isDark = getThemePreference() === "dark"
  document.documentElement.classList[isDark ? "add" : "remove"]("dark")

  if (typeof localStorage !== "undefined") {
    const observer = new MutationObserver(() => {
      const isDark = document.documentElement.classList.contains("dark")
      localStorage.setItem("theme", isDark ? "dark" : "light")
    })
    observer.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["class"],
    })
  }
</script>

<Layout>
  <main class="p-4 text-slate-700 dark:text-slate-400">
    <section class="flex flex-col w-full h-screen justify-center items-center">
      <p
        class="max-w-56 text-center"
      >
        Hello, I'm <strong>Noorish</strong>, an AI Researcher and Backend Engineer pursuing my Masters in Germany.
      </p>
      <DownIcon className="text-2xl animate-bounce mt-10" />
    </section>
    <section class="flex flex-col w-full justify-center items-center gap-28">
      <h2 class="font-bold">Experience</h2>
      <Timeline />
    </section>
    <section class="flex flex-col w-full justify-center items-center gap-28 mt-56">
      <h2 class="font-bold">Education</h2>
      <Education client:load />
    </section>
    <section class="flex flex-col w-full justify-center items-center gap-28 mt-56">
      <h2 class="font-bold">Skills</h2>
      <Skills client:load />
    </section>
    <section class="flex flex-col w-full justify-center items-center gap-28 mt-56">
      <h2 class="font-bold">Projects</h2>
      <ProjectSection client:load />
    </section>
    <section class="flex flex-col w-full justify-center items-center gap-28 mt-56">
      <h2 class="font-bold">About me</h2>
      <div class="flex flex-col items-center gap-4 max-w-[500px]">
        <Avatar src="/linkedin.png" alt="Noorish Hassan" client:load/>
        <p class="text-center">My name is <strong>Noorish Hassan</strong>, I started studying Computer Science in 2017 and I currently specialize in exploratory data analysis with a Master's Degree and in Backend Web Development with my WerkingStudent Job.</p>
        <p class="text-center">I am passionate about technology, learning new things, sharing knowledge and creating open source software.</p>
      </div>
    </section>
  </main>
  <footer>
    <p class="text-center text-sm text-slate-700 dark:text-slate-400 p-4 mt-28">
      Made with &#x2665; by Noorish Hassan | Template by <a href="https://github.com/slydragonn" target="_blank" class="underline">Alejandro Londoño</a>
    </p>
  </footer>
</Layout>
